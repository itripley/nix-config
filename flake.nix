{
  description = "NixOS, nix-darwin, NixOS-WSL and standalone home-manager configs for Olivia's machines";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-26.05";
    nixpkgs-unstable.url = "github:NixOS/nixpkgs/nixos-unstable";
    # The Mac's stable nixpkgs: the -darwin channel only advances once the darwin builds are cached
    nixpkgs-darwin.url = "github:NixOS/nixpkgs/nixpkgs-26.05-darwin";
    nix-darwin = {
      url = "github:nix-darwin/nix-darwin/nix-darwin-26.05";
      inputs.nixpkgs.follows = "nixpkgs-darwin";
    };

    home-manager = {
      url = "github:nix-community/home-manager/release-26.05";
      inputs.nixpkgs.follows = "nixpkgs";
    };
    plasma-manager = {
      url = "github:nix-community/plasma-manager";
      inputs.nixpkgs.follows = "nixpkgs";
      inputs.home-manager.follows = "home-manager";
    };
    disko = {
      url = "github:nix-community/disko";
      inputs.nixpkgs.follows = "nixpkgs";
    };
    nix-flatpak.url = "github:gmodena/nix-flatpak";
    # Native Discord client (Rust). Its flake targets nixos-unstable, so share ours.
    serein = {
      url = "github:ViceVerse-cz/Serein";
      inputs.nixpkgs.follows = "nixpkgs-unstable";
    };
    # Claude Desktop (official Linux beta), repackaged from Anthropic's apt repo. Its flake
    # targets nixos-unstable, so share ours.
    claude-desktop = {
      url = "github:tomsch/claude-desktop-nix";
      inputs.nixpkgs.follows = "nixpkgs-unstable";
    };
    # ArtCraft apps (PhotoCraft, FilmCraft, ...) from their release AppImages. Its module
    # builds against our pkgs; follows only keeps flake.lock from pulling a second nixpkgs.
    artcraft = {
      url = "github:ipeglin/artcraft-nix";
      inputs.nixpkgs.follows = "nixpkgs";
    };
    # Vicinae launcher, per docs.vicinae.com/nixos: newer than nixpkgs, and its NixOS module
    # gives the input server the capability it needs to paste and expand snippets. No
    # nixpkgs follows on purpose: the package then matches vicinae.cachix.org (common.nix).
    vicinae.url = "github:vicinaehq/vicinae";
    # SilentSDDM login theme (as on Fedora). Its module builds against our pkgs; follows only
    # keeps flake.lock from pulling a second nixpkgs.
    silent-sddm = {
      url = "github:uiriansan/SilentSDDM";
      inputs.nixpkgs.follows = "nixpkgs";
    };
    # NixOS inside WSL on Windows machines (hosts/wsl)
    nixos-wsl = {
      url = "github:nix-community/NixOS-WSL/main";
      inputs.nixpkgs.follows = "nixpkgs";
    };
  };

  outputs =
    {
      self,
      nixpkgs,
      nixpkgs-unstable,
      nixpkgs-darwin,
      nix-darwin,
      home-manager,
      plasma-manager,
      disko,
      nix-flatpak,
      ...
    }@inputs:
    let
      inherit (nixpkgs) lib;

      # Workarounds for packages that don't build in the pinned nixpkgs
      buildFixes = import ./overlays/build-fixes.nix;
      # Packages defined in this repo (pkgs/)
      localPackages = import ./overlays/packages.nix;

      # One nixpkgs config for both package sets (stable and pkgs.unstable)
      nixpkgsConfig = {
        allowUnfree = true;
        # Only needed by Sublime Text 4 (still links the EOL OpenSSL 1.1).
        # Remove together with sublime4 in home/olivia/apps.nix.
        permittedInsecurePackages = [ "openssl-1.1.1w" ];
      };

      # Fast-moving tools (AI CLIs etc.) come from unstable as pkgs.unstable.<name>
      unstableOverlay = _final: prev: {
        unstable = import nixpkgs-unstable {
          inherit (prev.stdenv.hostPlatform) system;
          config = nixpkgsConfig;
          overlays = [ buildFixes ];
        };
      };

      # Same overlays and config on both hosts
      nixpkgsModule = {
        nixpkgs.overlays = [
          buildFixes
          localPackages
          unstableOverlay
        ];
        nixpkgs.config = nixpkgsConfig;
      };

      # home-manager settings both hosts use (the NixOS and nix-darwin modules take the same ones)
      homeManagerModule = {
        home-manager = {
          useGlobalPkgs = true;
          useUserPackages = true;
          backupFileExtension = "hm-backup";
          extraSpecialArgs = { inherit inputs; };
        };
      };

      # Tooling for working on this repo (formatter, lint, dev shell) on both hosts; stable is enough
      system = "x86_64-linux";
      toolingNixpkgs = {
        x86_64-linux = nixpkgs;
        aarch64-darwin = nixpkgs-darwin;
      };
      forEachSystem = f: lib.mapAttrs (sys: np: f np.legacyPackages.${sys}) toolingNixpkgs;
      # hardware-configuration.nix is generated by nixos-generate-config; leave it as written
      generated = "hosts/*/hardware-configuration.nix";

      # Every directory in hosts/ is a machine (scripts/bootstrap.sh adds new ones):
      # darwin-configuration.nix makes it a Mac, configuration.nix a NixOS system
      hostNames = lib.attrNames (
        lib.filterAttrs (_: type: type == "directory") (builtins.readDir ./hosts)
      );
      isMac = name: builtins.pathExists ./hosts/${name}/darwin-configuration.nix;

      mkNixos =
        name:
        lib.nixosSystem {
          specialArgs = { inherit inputs; };
          modules = [
            nixpkgsModule
            disko.nixosModules.disko
            inputs.artcraft.nixosModules.default
            inputs.vicinae.nixosModules.default
            inputs.silent-sddm.nixosModules.default
            ./hosts/${name}/configuration.nix

            home-manager.nixosModules.home-manager
            homeManagerModule
            {
              home-manager.sharedModules = [
                plasma-manager.homeModules.plasma-manager
                nix-flatpak.homeManagerModules.nix-flatpak
                # Replaces home-manager's own programs.vicinae module
                inputs.vicinae.homeManagerModules.default
              ];
            }
          ];
        };

      mkDarwin =
        name:
        nix-darwin.lib.darwinSystem {
          specialArgs = { inherit inputs; };
          modules = [
            nixpkgsModule
            ./hosts/${name}/darwin-configuration.nix

            home-manager.darwinModules.home-manager
            homeManagerModule
          ];
        };

      # Standalone home-manager, for machines whose OS this repo doesn't manage: other Linux
      # distros (WSL ones too) and Macs without nix-darwin. One output per user and system,
      # e.g. `olivia@x86_64-linux`. A machine with another username needs it added here.
      standaloneUsers = [
        "olivia"
        "olivi"
      ];
      # What each system gets: GUI apps only on x86_64 Linux (most of them are x86_64-only)
      standaloneHome = {
        x86_64-linux = ./home/linux;
        aarch64-linux = ./home/shared;
        aarch64-darwin = ./home/darwin;
      };
      mkHome =
        system: user:
        let
          inherit (lib.systems.elaborate system) isDarwin;
        in
        home-manager.lib.homeManagerConfiguration {
          pkgs = import (if isDarwin then nixpkgs-darwin else nixpkgs) {
            inherit system;
            config = nixpkgsConfig;
            inherit (nixpkgsModule.nixpkgs) overlays;
          };
          extraSpecialArgs = { inherit inputs; };
          modules = [
            standaloneHome.${system}
            ./home/standalone.nix
            {
              home.username = user;
              home.homeDirectory = "${if isDarwin then "/Users" else "/home"}/${user}";
            }
          ]
          # Non-NixOS distro: XDG paths, and GPU drivers for Nix GUI apps (`non-nixos-gpu-setup`)
          ++ lib.optional (!isDarwin) { targets.genericLinux.enable = true; };
        };

      # What `nix flake check` instantiates on each system: every machine, plus one standalone
      # home per system (the users differ only in their name)
      evalTargets = {
        x86_64-linux =
          map (host: host.config.system.build.toplevel.drvPath) (lib.attrValues self.nixosConfigurations)
          ++
            map
              (system: self.homeConfigurations."${lib.head standaloneUsers}@${system}".activationPackage.drvPath)
              [
                "x86_64-linux"
                "aarch64-linux"
              ];
        aarch64-darwin = map (host: host.system.drvPath) (lib.attrValues self.darwinConfigurations) ++ [
          self.homeConfigurations."${lib.head standaloneUsers}@aarch64-darwin".activationPackage.drvPath
        ];
      };
    in
    {
      # `nh os switch` on a NixOS machine (picks the config by hostname)
      nixosConfigurations = lib.genAttrs (lib.filter (name: !isMac name) hostNames) mkNixos;

      # `sudo darwin-rebuild switch --flake ~/nix-config` on a Mac (picks it by hostname)
      darwinConfigurations = lib.genAttrs (lib.filter isMac hostNames) mkDarwin;

      # `home-manager switch --flake ~/nix-config#<user>@<system>`
      homeConfigurations = lib.listToAttrs (
        lib.concatMap (
          user:
          map (system: lib.nameValuePair "${user}@${system}" (mkHome system user)) (
            lib.attrNames standaloneHome
          )
        ) standaloneUsers
      );

      # `nix build .#warp-cloudflare-gui`: the repo's own packages, from the system's package set
      # (overlays + unfree config applied)
      packages.${system} = {
        inherit (self.nixosConfigurations.desktop-olivia.pkgs)
          warp-cloudflare-gui
          obsidian-plugins
          vscode-marketplace
          ;
      };

      # `nix fmt`: nixfmt over every .nix file except the generated one
      formatter = forEachSystem (
        pkgs:
        pkgs.nixfmt-tree.override {
          settings.formatter.nixfmt.excludes = [ generated ];
        }
      );

      # `nix flake check`: full evaluation of every machine and home for this system (instantiates
      # every .drv, builds nothing) plus lint. Cheap enough for CI, unlike building the systems.
      checks = forEachSystem (pkgs: {
        # A plain drvPath string would make this depend on every output in the build closure
        # (it started fetching sources); discarding that keeps only the .drv files themselves.
        toplevel-eval = pkgs.writeText "toplevel-drv" (
          lib.concatMapStringsSep "\n" builtins.unsafeDiscardOutputDependency
            evalTargets.${pkgs.stdenv.hostPlatform.system}
        );
        lint =
          pkgs.runCommand "lint"
            {
              nativeBuildInputs = [
                pkgs.statix
                pkgs.deadnix
                pkgs.nixfmt
              ];
            }
            ''
              cd ${self}
              statix check .
              files=$(find . -name '*.nix' ! -path './${generated}')
              deadnix --fail $files
              nixfmt --check $files
              touch $out
            '';
      });

      # `nix develop`: the tools above plus nvd (diff two system closures) and the nil LSP
      devShells = forEachSystem (pkgs: {
        default = pkgs.mkShell {
          packages = [
            pkgs.nixfmt-tree
            pkgs.statix
            pkgs.deadnix
            pkgs.nvd
            pkgs.nil
          ];
        };
      });
    };
}
