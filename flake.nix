{
  description = "NixOS config for desktop-olivia (dual-boot with Windows 11)";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-26.05";
    nixpkgs-unstable.url = "github:NixOS/nixpkgs/nixos-unstable";

    home-manager = {
      url = "github:nix-community/home-manager/release-26.05";
      inputs.nixpkgs.follows = "nixpkgs";
    };
    plasma-manager = {
      url = "github:nix-community/plasma-manager";
      inputs.nixpkgs.follows = "nixpkgs";
      inputs.home-manager.follows = "home-manager";
    };
    disko = {
      url = "github:nix-community/disko";
      inputs.nixpkgs.follows = "nixpkgs";
    };
    nix-flatpak.url = "github:gmodena/nix-flatpak";
    # Native Discord client (Rust). Its flake targets nixos-unstable, so share ours.
    serein = {
      url = "github:ViceVerse-cz/Serein";
      inputs.nixpkgs.follows = "nixpkgs-unstable";
    };
    # Claude Desktop (official Linux beta), repackaged from Anthropic's apt repo. Its flake
    # targets nixos-unstable, so share ours.
    claude-desktop = {
      url = "github:tomsch/claude-desktop-nix";
      inputs.nixpkgs.follows = "nixpkgs-unstable";
    };
    # ArtCraft apps (PhotoCraft, FilmCraft, ...) from their release AppImages. Its module
    # builds against our pkgs; follows only keeps flake.lock from pulling a second nixpkgs.
    artcraft = {
      url = "github:ipeglin/artcraft-nix";
      inputs.nixpkgs.follows = "nixpkgs";
    };
  };

  outputs =
    {
      self,
      nixpkgs,
      nixpkgs-unstable,
      home-manager,
      plasma-manager,
      disko,
      nix-flatpak,
      ...
    }@inputs:
    let
      # Workarounds for packages that don't build in the pinned nixpkgs
      buildFixes = import ./overlays/build-fixes.nix;

      # Fast-moving tools (AI CLIs etc.) come from unstable as pkgs.unstable.<name>
      unstableOverlay = _final: prev: {
        unstable = import nixpkgs-unstable {
          inherit (prev.stdenv.hostPlatform) system;
          config.allowUnfree = true;
          overlays = [ buildFixes ];
        };
      };

      # Tooling for working on this repo (formatter, lint, dev shell); stable is enough
      system = "x86_64-linux";
      pkgs = nixpkgs.legacyPackages.${system};
      # hardware-configuration.nix is generated by nixos-generate-config; leave it as written
      generated = "hosts/*/hardware-configuration.nix";
    in
    {
      nixosConfigurations.desktop-olivia = nixpkgs.lib.nixosSystem {
        specialArgs = { inherit inputs; };
        modules = [
          {
            nixpkgs.overlays = [
              buildFixes
              unstableOverlay
            ];
            nixpkgs.config.allowUnfree = true;
            # Only needed by Sublime Text 4 (still links the EOL OpenSSL 1.1).
            # Remove together with sublime4 in home/olivia/apps.nix.
            nixpkgs.config.permittedInsecurePackages = [ "openssl-1.1.1w" ];
          }
          disko.nixosModules.disko
          inputs.artcraft.nixosModules.default
          ./hosts/desktop-olivia/configuration.nix

          home-manager.nixosModules.home-manager
          {
            home-manager = {
              useGlobalPkgs = true;
              useUserPackages = true;
              backupFileExtension = "hm-backup";
              extraSpecialArgs = { inherit inputs; };
              sharedModules = [
                plasma-manager.homeModules.plasma-manager
                nix-flatpak.homeManagerModules.nix-flatpak
              ];
              users.olivia = import ./home/olivia;
            };
          }
        ];
      };

      # `nix fmt`: nixfmt over every .nix file except the generated one
      formatter.${system} = pkgs.nixfmt-tree.override {
        settings.formatter.nixfmt.excludes = [ generated ];
      };

      # `nix flake check`: full system evaluation (instantiates every .drv, builds nothing)
      # plus lint. Cheap enough for CI, unlike building the 40+ GiB system.
      checks.${system} = {
        # A plain drvPath string would make this depend on every output in the build closure
        # (it started fetching sources); discarding that keeps only the .drv file itself.
        toplevel-eval = pkgs.writeText "desktop-olivia-drv" (
          builtins.unsafeDiscardOutputDependency self.nixosConfigurations.desktop-olivia.config.system.build.toplevel.drvPath
        );
        lint =
          pkgs.runCommand "lint"
            {
              nativeBuildInputs = [
                pkgs.statix
                pkgs.deadnix
                pkgs.nixfmt
              ];
            }
            ''
              cd ${self}
              statix check .
              files=$(find . -name '*.nix' ! -path './${generated}')
              deadnix --fail $files
              nixfmt --check $files
              touch $out
            '';
      };

      # `nix develop`: the tools above plus nvd (diff two system closures) and the nil LSP
      devShells.${system}.default = pkgs.mkShell {
        packages = [
          pkgs.nixfmt-tree
          pkgs.statix
          pkgs.deadnix
          pkgs.nvd
          pkgs.nil
        ];
      };
    };
}
