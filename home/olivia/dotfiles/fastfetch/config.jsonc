{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/ascii.txt",
    "type": "file",
    "color": {
      "1": "38;2;245;194;231",
      "2": "38;2;235;188;186",
      "3": "38;2;246;193;119",
      "4": "38;2;156;207;216",
      "5": "38;2;196;167;231",
    },
  },
  "display": {
    "separator": "  ",
    "color": "38;2;245;194;231",
    "constants": [
      "\u001b[38;2;245;194;231m",
      "\u001b[38;2;235;188;186m",
      "\u001b[38;2;246;193;119m",
      "\u001b[38;2;156;207;216m",
      "\u001b[38;2;196;167;231m",
    ],
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "key": "╭───────────────────────────────────╮",
    },
    {
      "type": "kernel",
      "key": "│ {$2}{$1}  kernel",
      "format": "{$1}{release>22}{$1} │",
    },
    {
      "type": "uptime",
      "key": "│ {$3}{$1}  uptime",
      "format": "{$1}{formatted>22}{$1} │",
    },
    {
      "type": "shell",
      "key": "│ {$4}{$1}  shell ",
      "format": "{$1}{pretty-name>22}{$1} │",
    },
    {
      "type": "memory",
      "key": "│ {$5}{$1}  mem   ",
      "format": "{$1}{used>10} / {total>9}{$1} │",
    },
    {
      "type": "packages",
      "key": "│ {$2}{$1}  pkgs  ",
      "format": "{$1}{all>22}{$1} │",
    },
    {
      "type": "command",
      "key": "│ {$3}{$1}  user  ",
      "text": "echo $USER",
      "format": "{$1}{>22}{$1} │",
    },
    {
      "type": "title",
      "key": "│ {$4}{$1}  hname ",
      "format": "{$1}{host-name>22}{$1} │",
    },
    {
      "type": "os",
      "key": "│ {$5}󰻀{$1}  distro",
      "format": "{$1}{pretty-name>22}{$1} │",
    },
    {
      "type": "custom",
      "key": "╰───────────────────────────────────╯",
    },
    "break",
  ],
}
